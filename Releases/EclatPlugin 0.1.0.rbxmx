<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBX5b2efef51e653d69">
		<Properties>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">EclatPlugin</string>
			<int64 name="SourceAssetId">-1</int64>
			<BinaryString name="Tags"></BinaryString>
		</Properties>
		<Item class="Script" referent="RBX066d8bb5315e9075">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">Main</string>
				<ProtectedString name="Source">--!strict
				--!optimize 2

				--&gt; [`toolbar`]
				local Toolbar = plugin:CreateToolbar("Éclat")
				local Toggle = Toolbar:CreateButton("EclatOpen", "Open Éclat", "", "Éclat")

				local EclatData = script.Parent:WaitForChild("EclatData") :: ModuleScript
				local Eclat = require(EclatData)

				Toggle.Click:Connect(function()
					Eclat.open(plugin)
				end)
				</ProtectedString>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXf6a00817b43b33e7">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">EclatData</string>
				<ProtectedString name="Source">--!strict
				--!optimize 2

				--&gt; [`eclat`]
				local Panel = require(script.Core.Panel)

				local Eclat = {}

				export type Handle = Panel.Handle

				Eclat.VERSION = "1.3.1"

				function Eclat.open(plugin: Plugin): Panel.Handle
					return Panel.open(plugin)
				end

				return table.freeze(Eclat)
				</ProtectedString>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
			<Item class="Folder" referent="RBXc4115a4162e00348">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Core</string>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
				<Item class="ModuleScript" referent="RBXc4519b68cffb9fc0">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">ApiDump</string>
						<ProtectedString name="Source">--!strict


						local HttpService = game:GetService("HttpService")

						local ApiDump = {}

						ApiDump.DUMP_URL = "https://raw.githubusercontent.com/MaximumADHD/Roblox-Client-Tracker/roblox/API-Dump.json"

						local CURATED: { [string]: { string } } = {
							MeshPart = {
								"CFrame",
								"Size",
								"Color",
								"Material",
								"Transparency",
								"Anchored",
								"CanCollide",
								"CanQuery",
								"CanTouch",
								"CollisionFidelity",
								"RenderFidelity",
								"FluidFidelity",
								"CollisionGroup",
								"Massless",
								"RootPriority",
								"CustomPhysicalProperties",
								"MaterialVariant",
								"MeshSize",
								"Name",
								"Orientation",
								"Position",
								"Rotation",
								"Reflectance",
								"CastShadow",
								"DoubleSided",
								"AssemblyLinearVelocity",
								"AssemblyAngularVelocity",
							},
						}

						local cache: { [string]: { string } }? = nil

						function ApiDump.isCached(): boolean
							return cache ~= nil
						end

						local function warm(): { [string]: { string } }
							local dump: { [string]: { string } } = {}
							local ok, body = pcall(HttpService.GetAsync, HttpService, ApiDump.DUMP_URL)
							if not ok then
								return dump
							end
							local decoded, parsed = pcall(HttpService.JSONDecode, HttpService, body)
							if not decoded then
								return dump
							end
							local classes = (parsed :: any).Classes
							if typeof(classes) ~= "table" then
								return dump
							end
							for _, class in classes do
								local members = (class :: any).Members
								if typeof(members) == "table" then
									local props: { string } = {}
									for _, member in members do
										local info = member :: any
										if info.MemberType == "Property" then
											table.insert(props, info.Name)
										end
									end
									dump[(class :: any).Name] = props
								end
							end
							return dump
						end

						function ApiDump.getProperties(className: string): { string }
							if cache == nil then
								cache = warm()
							end
							local known = (cache :: { [string]: { string } })[className]
							if known ~= nil and #known &gt; 0 then
								return known
							end
							local curated = CURATED[className]
							if curated ~= nil then
								return curated
							end
							return {}
						end

						return table.freeze(ApiDump)
						</ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXe4495a5c59d79e90">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Connection</string>
						<ProtectedString name="Source">--!strict


						local HttpService = game:GetService("HttpService")

						local Connection = {}

						export type Connection = {
							_port: number,
							_thread: thread?,

							onData: ((data: string) -&gt; ())?,
							onDisconnect: (() -&gt; ())?,

							Send: (self: Connection, path: string, body: string) -&gt; (boolean, string),
							Destroy: (self: Connection) -&gt; (),
						}

						local function get(port: number): string
							return HttpService:GetAsync(`http://127.0.0.1:{port}/`)
						end

						local function post(port: number, path: string, data: string): string
							return HttpService:PostAsync(`http://127.0.0.1:{port}{path}`, data, Enum.HttpContentType.ApplicationJson)
						end

						local function checkConnectionStatus(self: Connection)
							local connected, data = pcall(get, self._port)
							if not connected then
								if self.onDisconnect then
									self.onDisconnect()
								end
								self:Destroy()
								return
							end

							if self.onData then
								self.onData(data :: string)
							end
							self._thread = task.delay(0.5, checkConnectionStatus, self)
						end

						local function Send(self: Connection, path: string, body: string): (boolean, string)
							local success, response = pcall(post, self._port, path, body)
							return success :: boolean, response :: string
						end

						local function Destroy(self: Connection)
							if self._thread ~= nil then
								task.cancel(self._thread)
								self._thread = nil
							end
							table.clear(self :: any)
						end

						function Connection.new(port: number): (Connection?, string?)
							local connected, data = pcall(get, port)
							if not connected then
								return nil, nil
							end

							local self: Connection = {
								_port = port,
								_thread = nil,
								onData = nil,
								onDisconnect = nil,
								Send = Send,
								Destroy = Destroy,
							}
							self._thread = task.delay(0.5, checkConnectionStatus, self)

							local text = data :: string
							if text == "" or text == "null\n" then
								return self, nil
							end
							return self, text
						end

						return table.freeze(Connection)
						</ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX523bc2400038a228">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Constants</string>
						<ProtectedString name="Source">--!strict
						--!optimize 2

						-- Shared colors, sizes, fonts, and tween infos.

						local Constants = {
							BlueNormal = Color3.fromRGB(71, 129, 255),
							BlueHover = Color3.fromRGB(86, 143, 255),
							BluePressed = Color3.fromRGB(58, 109, 218),

							RowDefault = Color3.fromRGB(25, 26, 31),
							RowHover = Color3.fromRGB(32, 34, 40),
							MenuDefault = Color3.fromRGB(39, 41, 48),
							MenuHover = Color3.fromRGB(45, 48, 56),
							HeaderDefault = Color3.fromRGB(32, 34, 39),
							HeaderHover = Color3.fromRGB(35, 38, 43),
							RootBackground = Color3.fromRGB(22, 23, 28),

							TextMain = Color3.fromRGB(222, 222, 222),
							TextDim = Color3.fromRGB(150, 152, 162),

							StrokeDefault = Color3.fromRGB(54, 56, 66),
							StrokeHover = Color3.fromRGB(77, 80, 94),
							StrokeFocus = Color3.fromRGB(41, 180, 255),
							StrokeSelected = Color3.fromRGB(88, 146, 255),
							StrokeInvalid = Color3.fromRGB(255, 86, 86),

							ToggleOff = Color3.fromRGB(40, 41, 49),
							ToggleOffHover = Color3.fromRGB(55, 57, 66),
							ToggleOffPressed = Color3.fromRGB(31, 32, 39),

							FontRegular = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
							FontSemiBold = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.SemiBold, Enum.FontStyle.Normal),

							RowSize = UDim2.new(1, 0, 0, 26),
							ItemSize = UDim2.new(1, 0, 0, 18),

							BubbleOn = UDim2.new(1, -6, 0.5, 0),
							BubbleOff = UDim2.new(0, 6, 0.5, 0),

							FastInfo = TweenInfo.new(0.13, Enum.EasingStyle.Quart),
							SlowInfo = TweenInfo.new(0.30, Enum.EasingStyle.Quart),
							SmoothInfo = TweenInfo.new(0.20, Enum.EasingStyle.Quart),
							BounceInfo = TweenInfo.new(0.13, Enum.EasingStyle.Back),
						}

						return table.freeze(Constants)
						</ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX979fa3d487f0bd0a">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Controls</string>
						<ProtectedString name="Source">--!strict
						--!optimize 2

						-- Setting row controls: toggle, text box, and dropdown.

						local UserInputService = game:GetService("UserInputService")

						local Constants = require(script.Parent.Constants)
						local Hover = require(script.Parent.Hover)
						local Input = require(script.Parent.Input)
						local Layout = require(script.Parent.Layout)
						local Templates = require(script.Parent.Templates)

						export type Context = {
							TweenService: TweenService,
							PluginGuiService: PluginGuiService?,
							FastInfo: TweenInfo,
							SlowInfo: TweenInfo,
							OnInfoButtonClicked: (title: string, lines: { string }, row: GuiObject) -&gt; (),
							OnSetLoaded: (name: string, set: Layout.Set, control: Control) -&gt; (),
							SetDropdownOpen: (open: boolean) -&gt; (),
						}

						export type Control = {
							Get: () -&gt; any,
							Set: (next: any) -&gt; (),
							Row: GuiObject,
						}

						type CustomEntry = {
							Key: string,
							Label: string,
							Item: TextButton,
							Binding: Hover.Binding,
						}

						local openCloser: ((animate: boolean?) -&gt; ())? = nil
						local openScope: GuiObject? = nil
						local watcherConnected = false

						local function setSearchText(row: GuiObject, text: string)
							row:SetAttribute("SearchText", string.lower(text))
						end

						local function connectWatcher()
							if watcherConnected then
								return
							end
							watcherConnected = true
							UserInputService.InputBegan:Connect(function(input: InputObject)
								local closer = openCloser
								local scope = openScope
								if closer and scope and Input.IsSelectInput(input) then
									local point = Input.GetInputPoint(input)
									if not Input.IsPointInFrame(point, scope) then
										openCloser = nil
										openScope = nil
										closer()
									end
								end
							end)
						end

						--&gt; [`toggle`]
						local function buildBoolean(
							context: Context,
							set: Layout.Set,
							defaults: { [string]: any },
							values: { [string]: any },
							order: number
						): GuiObject
							local row = Templates.boolean()
							row.Name = set.Name
							row.LayoutOrder = order
							local tap = row:WaitForChild("Tap") :: TextButton
							local mark = tap:WaitForChild("Mark") :: Frame
							local bubble = mark:WaitForChild("Bubble") :: Frame
							local title = row:WaitForChild("Title") :: TextButton
							local info = title:WaitForChild("Info") :: ImageButton
							title.Text = set.Display

							local value = defaults[set.Name]
							if typeof(value) ~= "boolean" then
								value = set.Default == true
							end
							values[set.Name] = value

							local normalStyle: Hover.Style = { Background = Constants.RowDefault, Stroke = nil }
							local hoverStyle: Hover.Style = { Background = Constants.RowHover, Stroke = nil }
							Hover.bind(tap, context.TweenService, context.FastInfo, normalStyle, hoverStyle, nil, nil)
							Hover.bind(title, context.TweenService, context.FastInfo, normalStyle, hoverStyle, nil, nil)

							local function setValue(next: boolean, silent: boolean?)
								if not silent and value == next then
									return
								end
								value = next
								values[set.Name] = value
								local markGoal: Color3
								local bubbleGoal: UDim2
								if value then
									markGoal = Constants.BlueNormal
									bubbleGoal = Constants.BubbleOn
								else
									markGoal = Constants.ToggleOff
									bubbleGoal = Constants.BubbleOff
								end
								if silent then
									mark.BackgroundColor3 = markGoal
									bubble.Position = bubbleGoal
									return
								end
								context.TweenService:Create(mark, context.SlowInfo, { BackgroundColor3 = markGoal }):Play()
								context.TweenService:Create(bubble, context.SlowInfo, { Position = bubbleGoal }):Play()
							end
							setValue(value, true)

							local function getValue(): any
								return value
							end

							local function applyValue(next: any)
								if typeof(next) == "boolean" then
									setValue(next)
								end
							end

							info.MouseButton1Click:Connect(function()
								context.OnInfoButtonClicked(set.Display, { set.Description }, row)
							end)
							tap.MouseButton1Click:Connect(function()
								setValue(not value)
							end)
							context.OnSetLoaded(set.Name, set, {
								Get = getValue,
								Set = applyValue,
								Row = row,
							})
							setSearchText(row, `{set.Display} {set.Description}`)
							return row
						end

						--&gt; [`text`]
						local function buildText(
							context: Context,
							set: Layout.Set,
							defaults: { [string]: any },
							values: { [string]: any },
							order: number
						): GuiObject
							local row = Templates.text()
							row.Name = set.Name
							row.LayoutOrder = order
							local title = row:WaitForChild("Title") :: TextButton
							local info = title:WaitForChild("Info") :: ImageButton
							local box = row:WaitForChild("Box") :: TextBox
							local stroke = box:WaitForChild("Stroke") :: UIStroke
							title.Text = set.Display

							local saved = defaults[set.Name]
							local value: string
							if typeof(saved) == "string" then
								value = saved
							elseif typeof(set.Default) == "string" then
								value = set.Default
							else
								value = ""
							end
							values[set.Name] = value
							box.Text = value
							local focused = false

							local normalStyle: Hover.Style = { Background = Constants.RowDefault, Stroke = nil }
							local hoverStyle: Hover.Style = { Background = Constants.RowHover, Stroke = nil }
							Hover.bind(title, context.TweenService, context.FastInfo, normalStyle, hoverStyle, nil, nil)

							local function refreshSearch()
								setSearchText(row, `{set.Display} {set.Description} {value}`)
							end

							local function setStroke(color: Color3)
								context.TweenService:Create(stroke, context.FastInfo, { Color = color }):Play()
							end

							local function getValue(): any
								return value
							end

							local function applyValue(next: any)
								if typeof(next) == "string" then
									value = next
									values[set.Name] = value
									if box.Text ~= value then
										box.Text = value
									end
									refreshSearch()
								end
							end

							box.Focused:Connect(function()
								focused = true
								setStroke(Constants.StrokeFocus)
							end)
							box.FocusLost:Connect(function()
								focused = false
								setStroke(Constants.StrokeDefault)
								if box.Text ~= value then
									value = box.Text
									values[set.Name] = value
									refreshSearch()
								end
							end)
							box:GetPropertyChangedSignal("Text"):Connect(function()
								if focused and box.Text ~= value then
									value = box.Text
									values[set.Name] = value
									refreshSearch()
								end
							end)
							info.MouseButton1Click:Connect(function()
								context.OnInfoButtonClicked(set.Display, { set.Description }, row)
							end)
							context.OnSetLoaded(set.Name, set, {
								Get = getValue,
								Set = applyValue,
								Row = row,
							})
							refreshSearch()
							return row
						end

						--&gt; [`custom`]
						local function buildCustom(
							context: Context,
							set: Layout.Set,
							defaults: { [string]: any },
							values: { [string]: any },
							order: number
						): GuiObject
							local options = set.Type
							assert(typeof(options) == "table", `[Éclat/Controls] custom set {set.Name} needs a table of options`)
							local row = Templates.custom()
							row.Name = set.Name
							row.LayoutOrder = order
							local title = row:WaitForChild("Title") :: TextButton
							local info = title:WaitForChild("Info") :: ImageButton
							local tap = row:WaitForChild("Tap") :: TextButton
							local tapStroke = tap:WaitForChild("Stroke") :: UIStroke
							local down = tap:WaitForChild("Down") :: TextButton
							local items = row:WaitForChild("Items") :: Frame
							title.Text = set.Display

							local entries: { CustomEntry } = {}
							local seenLabels: { [string]: number } = {}
							for key, label in options do
								local labelText = tostring(label)
								local seen = seenLabels[labelText] or 0
								seenLabels[labelText] = seen + 1
								if seen &gt; 0 then
									labelText = `{labelText} ({seen + 1})`
								end
								local item = Templates.item()
								item.LayoutOrder = #entries + 1
								local labelHolder = item:WaitForChild("Pad")
								labelHolder:Destroy()
								item.Text = labelText
								table.insert(entries, {
									Key = tostring(key),
									Label = labelText,
									Item = item,
									Binding = Hover.bind(item, context.TweenService, context.FastInfo, {
										Background = Constants.RowDefault,
										Stroke = nil,
									}, {
										Background = Constants.RowHover,
										Stroke = nil,
									}, nil, nil),
								})
							end
							table.sort(entries, function(a: CustomEntry, b: CustomEntry): boolean
								return a.Label &lt; b.Label
							end)
							local list = items:WaitForChild("List") :: UIListLayout
							list.SortOrder = Enum.SortOrder.LayoutOrder
							for index, entry in entries do
								entry.Item.LayoutOrder = index
								entry.Item.Parent = items
							end

							local saved = defaults[set.Name]
							local value: string
							if typeof(saved) == "string" then
								value = saved
							else
								value = tostring(set.Default)
							end
							if options[value] == nil and #entries &gt; 0 then
								value = entries[1].Key
							end
							values[set.Name] = value
							tap.Text = tostring(options[value])

							local normalStyle: Hover.Style = { Background = Constants.RowDefault, Stroke = nil }
							local hoverStyle: Hover.Style = { Background = Constants.RowHover, Stroke = nil }
							Hover.bind(title, context.TweenService, context.FastInfo, normalStyle, hoverStyle, nil, nil)
							Hover.bind(tap, context.TweenService, context.FastInfo, normalStyle, hoverStyle, nil, nil)

							local isOpen = false
							local closedRowSize = UDim2.new(1, 0, 0, 26)
							local openRowSize = UDim2.new(1, 0, 0, 26 + 18 * #entries)
							local openItemsSize = UDim2.new(0.5, -1, 0, 18 * #entries)
							local closedItemsSize = UDim2.new(0.5, -1, 0, 0)

							local function closeDropdown(animate: boolean?)
								if not isOpen then
									return
								end
								isOpen = false
								tapStroke.Enabled = false
								context.SetDropdownOpen(false)
								context.TweenService:Create(down, context.FastInfo, { Rotation = 0 }):Play()
								if animate == false then
									row.Size = closedRowSize
									items.Size = closedItemsSize
									items.Visible = false
									return
								end
								context.TweenService:Create(row, context.SlowInfo, { Size = closedRowSize }):Play()
								local tween = context.TweenService:Create(items, context.SlowInfo, { Size = closedItemsSize })
								tween.Completed:Connect(function()
									if not isOpen then
										items.Visible = false
									end
								end)
								tween:Play()
							end

							local function openDropdown()
								if isOpen then
									return
								end
								connectWatcher()
								local previous = openCloser
								openCloser = nil
								openScope = nil
								if previous then
									previous(false)
								end
								isOpen = true
								tapStroke.Enabled = true
								context.SetDropdownOpen(true)
								context.TweenService:Create(down, context.SlowInfo, { Rotation = -90 }):Play()
								items.Visible = true
								context.TweenService:Create(row, context.SlowInfo, { Size = openRowSize }):Play()
								context.TweenService:Create(items, context.SlowInfo, { Size = openItemsSize }):Play()
								openCloser = closeDropdown
								openScope = row
							end

							local function refreshSearch()
								setSearchText(row, `{set.Display} {set.Description} {tap.Text}`)
							end

							local function choose(entry: CustomEntry)
								value = entry.Key
								values[set.Name] = value
								tap.Text = entry.Label
								refreshSearch()
								closeDropdown()
							end

							for _, entry in entries do
								local target = entry
								target.Item.MouseButton1Click:Connect(function()
									choose(target)
								end)
							end

							local function getValue(): any
								return value
							end

							local function applyValue(next: any)
								local key = tostring(next)
								if options[key] ~= nil then
									value = key
									values[set.Name] = value
									tap.Text = tostring(options[key])
									refreshSearch()
								end
							end

							tap.MouseButton1Click:Connect(function()
								if isOpen then
									closeDropdown()
								else
									openDropdown()
								end
							end)
							info.MouseButton1Click:Connect(function()
								context.OnInfoButtonClicked(set.Display, { set.Description }, row)
							end)
							context.OnSetLoaded(set.Name, set, {
								Get = getValue,
								Set = applyValue,
								Row = row,
							})
							refreshSearch()
							return row
						end

						--&gt; [`build`]
						local function build(
							context: Context,
							set: Layout.Set,
							defaults: { [string]: any },
							values: { [string]: any },
							order: number
						): GuiObject
							assert(typeof(set.Name) == "string", "[Éclat/Controls] set needs a name")
							assert(set.Type ~= nil, `[Éclat/Controls] set {set.Name} needs a type`)
							if set.Type == "Boolean" then
								return buildBoolean(context, set, defaults, values, order)
							elseif set.Type == "Text" then
								return buildText(context, set, defaults, values, order)
							elseif typeof(set.Type) == "table" then
								return buildCustom(context, set, defaults, values, order)
							end
							error(`[Éclat/Controls] unknown type for set {set.Name}`)
						end

						return build
						</ProtectedString>
